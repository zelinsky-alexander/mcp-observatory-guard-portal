#!/usr/bin/env python3
"""Run the Observatory CLI while holding one host-wide advisory writer lock."""

from __future__ import annotations

import fcntl
import os
from pathlib import Path
import subprocess
import sys


def main() -> int:
    real_binary = os.environ.get("MCP_OBSERVATORY_REAL_BINARY", "").strip()
    lock_name = os.environ.get("MCP_OBSERVATORY_WRITER_LOCK", "").strip()
    if not real_binary or not lock_name:
        print(
            "MCP_OBSERVATORY_REAL_BINARY and MCP_OBSERVATORY_WRITER_LOCK are required",
            file=sys.stderr,
        )
        return 2

    binary = Path(real_binary).expanduser().resolve()
    lock_path = Path(lock_name).expanduser().resolve()
    if not binary.is_file() or not os.access(binary, os.X_OK):
        print(f"Observatory binary is not executable: {binary}", file=sys.stderr)
        return 2
    if not lock_path.parent.is_dir():
        print(f"writer lock parent does not exist: {lock_path.parent}", file=sys.stderr)
        return 2

    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o640)
    try:
        with os.fdopen(lock_fd, "a+", encoding="utf-8") as lock_file:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            completed = subprocess.run(
                [str(binary), *sys.argv[1:]],
                stdin=sys.stdin,
                stdout=sys.stdout,
                stderr=sys.stderr,
                env=os.environ.copy(),
                check=False,
            )
            return completed.returncode
    except OSError as exc:
        print(f"cannot acquire Observatory writer lock: {exc}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
